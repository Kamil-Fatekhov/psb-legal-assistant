# Скопируйте в .env и заполните. Файл .env не коммитится.

# Режим веб-чата: auto | mock | core
#   mock — ответы из fixtures/rent_case.json, без API (для разработки интерфейса)
#   core — настоящий поиск (A) и ядро (B); нужна база в data/ и ключ API
#   auto — core, если найдены база и ключ, иначе mock
ASSISTANT_MODE=auto

# OpenAI-совместимый API организаторов (генерация, эмбеддинги, реранкер)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
# Необязательно: включает реранкер
RERANKER_MODEL=

# Где лежит база знаний: data/kb.zip или папка data/kb/ с TXT
DATA_DIR=data
# KB_PATH=data/kb.zip

# Порт на компьютере, на котором открывается чат (http://localhost:8000)
WEB_PORT=8000
LOG_LEVEL=info
# Задержка ответа мока, мс (чтобы видеть индикатор загрузки)
MOCK_DELAY_MS=300
